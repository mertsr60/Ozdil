# 1. algoritma
yazdır("[1] test: algoritma")
getir algoritma
değişken dizi = [5, 2, 9, 1, 5, 6]
algoritma.sirala(dizi)
yazdır("  - sirala [5,2,9,1,5,6] ->", dizi)
yazdır("  - en_buyuk ->", algoritma.en_buyuk(dizi))
yazdır("  - en_kucuk ->", algoritma.en_kucuk(dizi))
yazdır("  - toplam ->", algoritma.toplam(dizi))
yazdır("  - ortalama ->", algoritma.ortalama(dizi))
yazdır("  - asal_mi(17) ->", algoritma.asal_mi(17))
yazdır("  - ebob(24, 36) ->", algoritma.ebob(24, 36))
yazdır("  - ekok(12, 18) ->", algoritma.ekok(12, 18))
yazdır("  - fibonacci(8) ->", algoritma.fibonacci(8))
yazdır("--------------------------------------------------")

# 2. matematik
yazdır("[2] test: matematik")
