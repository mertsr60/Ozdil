# 11. kripto
yazdır("[11] test: kripto")
getir kripto
yazdır("  - md5_uret(\"varyn\") ->", kripto.md5_uret("varyn"))
yazdır("  - sha256_uret(\"varyn\") ->", kripto.sha256_uret("varyn"))
değişken kodlanmis = kripto.base64_kodla("Varyn Language")
yazdır("  - base64_kodla ->", kodlanmis)
yazdır("  - base64_coz ->", kripto.base64_coz(kodlanmis))
yazdır("  - sezar_sifrele(\"abc\", 3) ->", kripto.sezar_sifrele("abc", 3))
yazdır("--------------------------------------------------")

